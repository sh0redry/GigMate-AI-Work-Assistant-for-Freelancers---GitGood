# Synthetic development only. Copy to .env; never use these values for real accounts.
APP_MODE=replay
API_PORT=18000
WEB_PORT=18080
POSTGRES_USER=gigmate
POSTGRES_PASSWORD=local-replay-only
POSTGRES_DB=gigmate
DEMO_PASSWORD=demo-only-change-me
COOKIE_SECURE=false
TRUSTED_ORIGINS=http://localhost:18080,http://127.0.0.1:18080,http://localhost:5173,http://127.0.0.1:5173
# For native backend development with the Compose database:
DATABASE_URL=postgresql+psycopg://gigmate:local-replay-only@127.0.0.1:54329/gigmate

# --- Real model (DeepSeek, OpenAI-compatible) -------------------------------
# Server-side only. Paste your DeepSeek key below; never commit the real value.
# While the key is empty the provider refuses with `llm:not-configured` and
# makes no outbound call, so copying this file is safe.
GIGMATE_LLM_PROVIDER=deepseek
# Must support response_format=json_object. `deepseek-reasoner` does not and is
# refused locally with `llm:model-unsupported` instead of a vendor 400.
GIGMATE_LLM_MODEL=deepseek-chat
GIGMATE_LLM_API_KEY=
# Optional base URL override. Without it the endpoint follows the vendor:
# deepseek -> https://api.deepseek.com, openai -> https://api.openai.com,
# custom -> refused (set this variable explicitly).
# GIGMATE_LLM_ENDPOINT=https://api.deepseek.com
# Operator gate: 1 lets configured calls reach DeepSeek, anything else refuses.
GIGMATE_LLM_LIVE=1
# Uncomment to also let real (non-synthetic) customer content reach the model.
# GIGMATE_LLM_ALLOW_LIVE_ORIGIN=1
# Daily budget. At least one bound is required for live traffic; the worker
# sums today's committed model_call_traces and the provider refuses with
# `llm:budget-exhausted` before any vendor call once the bound is reached.
GIGMATE_LLM_DAILY_CALL_BUDGET=200
GIGMATE_LLM_DAILY_TOKEN_BUDGET=200000
# Optional narrowing allowlist (comma-separated account IDs). When set, only
# those accounts may send live content to the model.
# GIGMATE_LLM_LIVE_ACCOUNTS=
# Trusted workspace timezone used to resolve relative dates ("明天"). The
# provider refuses live extraction with `llm:time-basis-missing` when this or
# the message timestamp is missing, instead of guessing.
GIGMATE_WORKSPACE_TIMEZONE=Asia/Hong_Kong

# Select the LLM provider for extraction instead of the deterministic one.
GIGMATE_EXTRACTION_PROVIDER=llm

# --- Media (OCR / PDF / text) via the same DeepSeek credentials ------------
GIGMATE_MEDIA_CHAT_VENDOR=deepseek
GIGMATE_MEDIA_CHAT_MODEL=deepseek-chat
GIGMATE_MEDIA_API_KEY=
GIGMATE_MEDIA_LIVE=1
# Per-modality authorization. Only the listed modalities may send real bytes;
# an empty value refuses everything even when the live switch is on. Add `ocr`
# and `asr` only after their vendor has been verified.
GIGMATE_MEDIA_MODALITIES=pdf,text
# Vendors whose image input was actually verified. Empty means no OCR vendor is
# trusted; DeepSeek chat-completions is not assumed to accept images.
# GIGMATE_MEDIA_VISION_VENDORS=openai
# Audio (ASR) needs an OpenAI-compatible transcription endpoint, which DeepSeek
# does not expose; leave GIGMATE_MEDIA_AUDIO_VENDOR unset to refuse audio.
# GIGMATE_MEDIA_AUDIO_VENDOR=openai
# GIGMATE_MEDIA_AUDIO_MODEL=whisper-1
