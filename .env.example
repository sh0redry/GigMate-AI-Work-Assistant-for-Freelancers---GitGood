# Synthetic development only. Copy to .env; never use these values for real accounts.
APP_MODE=replay
API_PORT=18000
WEB_PORT=18080
POSTGRES_USER=gigmate
POSTGRES_PASSWORD=local-replay-only
POSTGRES_DB=gigmate
DEMO_PASSWORD=demo-only-change-me
COOKIE_SECURE=false
TRUSTED_ORIGINS=http://localhost:18080,http://127.0.0.1:18080,http://localhost:5173,http://127.0.0.1:5173
# For native backend development with the Compose database:
DATABASE_URL=postgresql+psycopg://gigmate:local-replay-only@127.0.0.1:54329/gigmate
# Role B extraction: the provider is still a closed seam. These stay unset by
# default; setting GIGMATE_LLM_LIVE alone cannot open it.
# GIGMATE_EXTRACTION_PROVIDER=deterministic
# GIGMATE_LLM_PROVIDER=deepseek
# GIGMATE_LLM_MODEL=deepseek-chat
# GIGMATE_LLM_API_KEY=
# GIGMATE_LLM_ENDPOINT=
# GIGMATE_LLM_LIVE=0
# GIGMATE_LLM_ALLOW_LIVE_ORIGIN=0
# Cost accounting (pre-activation batch 2, hard ceiling added with the review
# fixes). The seam is still closed, but the next authorized batch enforces
# these on every real call, so the surface is documented now.
# GIGMATE_LLM_COST_BUDGET_USD is the hard per-call ceiling in USD: it covers
# every attempt of one extraction, and the bounded worst case of a single
# attempt (estimated input + GIGMATE_LLM_MAX_OUTPUT_TOKENS) is checked
# *before* the request is paid for, so an unaffordable call is never issued.
# A response that still exceeds the budget is refused afterwards with
# llm:cost-budget-exceeded; a prompt larger than
# GIGMATE_LLM_MAX_INPUT_TOKENS is refused with llm:cost-input-too-large.
# Models outside the built-in price list need the two per-1K overrides,
# otherwise the call is refused with llm:cost-pricing-missing rather than
# issued unpriced. Non-positive token ceilings are reported at startup as
# llm:cost-tokens-invalid.
# GIGMATE_LLM_COST_BUDGET_USD=0.10
# GIGMATE_LLM_COST_INPUT_USD_PER_1K=0.00014
# GIGMATE_LLM_COST_OUTPUT_USD_PER_1K=0.00028
# GIGMATE_LLM_MAX_INPUT_TOKENS=4000
# GIGMATE_LLM_MAX_OUTPUT_TOKENS=1000
# Merchant timezone (IANA) used to ground relative dates such as "明天".
# Left unset, date-bearing proposals are refused for human review instead of
# being guessed.
# GIGMATE_WORKSPACE_TIMEZONE=Asia/Hong_Kong
