      "raw_patch": {"id": "synthetic:event-session-1", "event": "session.status", "payload": {"name": "synthetic:session-1", "status": "WORKING"}},
      "context_patch": {"message": null},
      "expect": {"event_type": "session.status", "payload": {"status": "connected"}, "conversation_id": null}
