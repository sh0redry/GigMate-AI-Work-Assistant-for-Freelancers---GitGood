    {"name": "unverified-source", "context_patch": {"source_verified": false}, "expect": {"error": "SOURCE_UNVERIFIED"}},
    {"name": "revoked-consent", "context_patch": {"consent_active": false}, "expect": {"error": "CONSENT_REVOKED"}},
    {"name": "not-allowlisted", "context_patch": {"message": {"allowlisted": false}}, "expect": {"error": "CONVERSATION_NOT_ALLOWED"}},
    {"name": "foreign-session", "raw_patch": {"session": "synthetic:other-session"}, "expect": {"error": "SESSION_MAPPING_MISMATCH"}},
    {"name": "missing-event-id", "raw_patch": {"id": null}, "expect": {"error": "EVENT_ID_REQUIRED"}},
    {"name": "missing-message-map", "context_patch": {"message": null}, "expect": {"error": "MESSAGE_MAPPING_REQUIRED"}},
    {"name": "wrong-chat", "raw_patch": {"payload": {"from": "synthetic:other-chat"}}, "expect": {"error": "CONVERSATION_MAPPING_MISMATCH"}},
    {"name": "wrong-message", "raw_patch": {"payload": {"id": "synthetic:other-message"}}, "expect": {"error": "MESSAGE_MAPPING_MISMATCH"}},
    {"name": "empty-text", "raw_patch": {"payload": {"body": ""}}, "expect": {"error": "INVALID_PROVIDER_SHAPE"}},
    {"name": "media-message", "raw_patch": {"payload": {"hasMedia": true}}, "expect": {"error": "UNSUPPORTED_MEDIA"}},
    {"name": "unsupported-event", "raw_patch": {"event": "message.reaction"}, "expect": {"error": "UNSUPPORTED_EVENT"}},
    {"name": "invalid-direction", "raw_patch": {"payload": {"fromMe": "false"}}, "expect": {"error": "INVALID_PROVIDER_SHAPE"}},
    {"name": "invalid-timestamp", "raw_patch": {"timestamp": true}, "expect": {"error": "INVALID_TIMESTAMP"}},
    {"name": "creation-wrong-revision", "context_patch": {"message": {"revision": 2}}, "expect": {"error": "VERSION_CONFLICT"}},
    {
