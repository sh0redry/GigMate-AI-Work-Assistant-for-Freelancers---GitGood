      "context_patch": {"message": {"provider_reference": "synthetic:edit-action", "revision": 2}},
      "expect": {"error": "MESSAGE_MAPPING_MISMATCH"}
    },
    {
      "name": "ack-error",
      "raw_patch": {"event": "message.ack", "payload": {"ack": -1, "ackName": "ERROR"}},
      "expect": {"error": "ACK_ERROR_NEEDS_RECONCILIATION"}
    },
    {
      "name": "unknown-session-state",
      "raw_patch": {"event": "session.status", "payload": {"name": "synthetic:session-1", "status": "UNRECOGNIZED"}},
