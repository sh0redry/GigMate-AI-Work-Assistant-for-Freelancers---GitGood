    "AccountConsent": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "format": "uuid",
          "title": "Account Id",
          "type": "string"
        },
        "allowed_conversation_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Allowed Conversation Ids",
          "type": "array"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expires At"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "scopes": {
          "items": {
            "enum": [
              "process_text",
              "prepare_drafts",
              "approved_send"
            ],
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        },
        "status": {
          "enum": [
            "active",
            "paused",
            "revoked"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "account_id",
        "allowed_conversation_ids",
        "scopes",
        "status",
        "expires_at"
      ],
      "title": "AccountConsent",
      "type": "object"
    },
    "ActionState": {
      "enum": [
        "draft",
        "pending_approval",
        "approved",
        "executing",
        "succeeded",
        "failed",
        "result_unknown",
        "cancelled",
        "expired"
      ],
      "title": "ActionState",
      "type": "string"
    },
    "ApprovalAction": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "approved",
                  "executing",
                  "succeeded",
                  "failed",
                  "result_unknown"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "approved_at": {
                "format": "date-time",
                "type": "string"
              },
              "approved_by": {
                "format": "uuid",
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "result_unknown"
              }
            }
          },
          "then": {
            "properties": {
              "delivery_status": {
                "const": "unknown"
              }
            }
          }
        }
      ],
      "properties": {
        "account_id": {
          "format": "uuid",
          "title": "Account Id",
          "type": "string"
        },
        "approved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Approved At"
        },
        "approved_by": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Approved By"
        },
        "body": {
          "minLength": 1,
          "title": "Body",
          "type": "string"
        },
        "bound_context_version": {
          "minimum": 1,
          "title": "Bound Context Version",
          "type": "integer"
        },
        "bound_work_order_version": {
          "minimum": 1,
          "title": "Bound Work Order Version",
          "type": "integer"
        },
        "conversation_id": {
          "format": "uuid",
          "title": "Conversation Id",
          "type": "string"
        },
        "delivery_status": {
          "enum": [
            "not_submitted",
            "accepted",
            "sent",
            "delivered",
            "read",
            "unknown"
          ],
          "title": "Delivery Status",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "pattern": "Z$",
          "title": "Expires At",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "idempotency_key": {
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        },
        "kind": {
          "const": "send_text",
          "title": "Kind",
          "type": "string"
        },
        "provider_message_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider Message Id"
        },
        "recipient": {
          "minLength": 1,
          "title": "Recipient",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "snapshot_hash": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Snapshot Hash",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/ActionState"
        },
        "work_order_id": {
          "format": "uuid",
          "title": "Work Order Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "account_id",
        "work_order_id",
        "conversation_id",
        "kind",
        "revision",
        "state",
        "recipient",
        "body",
        "bound_work_order_version",
        "bound_context_version",
        "snapshot_hash",
        "expires_at",
        "approved_by",
        "approved_at",
        "idempotency_key",
        "provider_message_id",
        "delivery_status",
        "sources"
      ],
      "title": "ApprovalAction",
      "type": "object"
    },
