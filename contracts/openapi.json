            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WorkOrder": {
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "format": "uuid",
            "title": "Account Id",
            "type": "string"
          },
          "conversation_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "minItems": 1,
            "title": "Conversation Ids",
            "type": "array"
          },
          "fields": {
            "$ref": "#/components/schemas/WorkOrderFields"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "pending_change_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Pending Change Ids",
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/WorkOrderStatus"
          },
          "summary": {
            "minLength": 1,
            "title": "Summary",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "pattern": "Z$",
            "title": "Updated At",
            "type": "string"
          },
          "version": {
            "minimum": 1.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "account_id",
          "conversation_ids",
          "summary",
          "status",
          "version",
          "fields",
          "pending_change_ids",
          "updated_at"
        ],
        "title": "WorkOrder",
        "type": "object"
      },
      "WorkOrderFields": {
        "additionalProperties": false,
        "properties": {
          "address": {
            "$ref": "#/components/schemas/ProvenancedField"
          },
          "schedule": {
            "$ref": "#/components/schemas/ProvenancedField"
          }
        },
        "required": [
          "schedule",
          "address"
        ],
        "title": "WorkOrderFields",
        "type": "object"
      },
      "WorkOrderStatus": {
        "enum": [
          "unclassified",
          "pending_confirmation",
          "confirmed",
          "in_progress",
          "waiting_customer",
          "completed",
          "cancelled"
        ],
        "title": "WorkOrderStatus",
        "type": "string"
      }
    }
  },
